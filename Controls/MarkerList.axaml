<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:andecr.ViewModels.Controls"
    x:Class="andecr.Controls.MarkerList"
    x:Name="MarkerListRoot"
    x:DataType="vm:IMarkerListViewModel">

    <Border
        Width="400"
        Background="#CC1E1E1E"
        CornerRadius="4"
        BorderThickness="1"
        BorderBrush="White">

        <StackPanel
            x:Name="InternalRoot"
            Orientation="Vertical">

            <StackPanel Orientation="Horizontal">

                <ComboBox
                    x:Name="MarkerComboBox"
                    PlaceholderText="Стилистическая пометка"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding AvailableMarkers}"
                    SelectedItem="{Binding SelectedMarkerToAdd, Mode=TwoWay}" />

                <Button Command="{Binding AddMarkerCommand}">
                    <TextBlock Text="Add" />
                </Button>
                
                <Button Command="{Binding ClearMarkersCommand}">
                    <TextBlock Text="Clear All"/>
                </Button>

            </StackPanel>

            <StackPanel
                x:Name="SelectedMarkersPanel"
                Orientation="Horizontal"
                Spacing="4"/>

        </StackPanel>

    </Border>

</UserControl>