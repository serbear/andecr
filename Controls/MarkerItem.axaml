<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="andecr.Controls.MarkerItem"
    xmlns:vm="using:andecr.ViewModels.Controls"
    x:Name="MarkerItemRoot"
    x:DataType="vm:IMarkerItemViewModel">

    <Border
        Background="Gray"
        CornerRadius="4"
        BorderThickness="0"
        VerticalAlignment="Center">

        <StackPanel
            x:Name="InternalRoot"
            Orientation="Horizontal"
            Margin="4">

            <TextBlock
                Text="{Binding Text, ElementName=MarkerItemRoot, Mode=TwoWay}"
                VerticalAlignment="Center" />
            <Button
                Command="{Binding RemoveMarkerCommand}"
                ToolTip.Tip="Remove the marker from the list.">

                <TextBlock Text="X" />

            </Button>

        </StackPanel>

    </Border>

</UserControl>