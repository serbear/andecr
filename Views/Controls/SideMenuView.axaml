<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:andecr.ViewModels"
             x:Class="andecr.Views.Controls.SideMenuView"
             x:DataType="vm:IDeckEditorViewModel">

  <!--
    Общее вертикальное меню для редакторов языковых колод (EstonianDeckView,
    EnglishDeckView и последующих). Хост-View должен иметь DataContext,
    реализующий IDeckEditorViewModel — тогда команды меню привяжутся автоматически.
  -->

  <UserControl.Styles>
    <Style Selector="Button.sideMenuItem">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="Margin" Value="8,3" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.sideMenuItem:pointerover">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Button.sideMenuItem:pressed">
      <Setter Property="Background" Value="#55FFFFFF" />
    </Style>
  </UserControl.Styles>

  <Border Width="140"
          Background="#CC1E1E1E"
          CornerRadius="0,12,12,0"
          Padding="0,20">
    <StackPanel Orientation="Vertical" Spacing="2">

      <Button Classes="sideMenuItem"
              Command="{Binding NewCardCommand}"
              ToolTip.Tip="Новая карточка">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="🆕" FontSize="18" VerticalAlignment="Center" />
          <TextBlock Text="Новая" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <Button Classes="sideMenuItem"
              Command="{Binding SaveCardCommand}"
              ToolTip.Tip="Сохранить карточку в колоду">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="💾" FontSize="18" VerticalAlignment="Center" />
          <TextBlock Text="Сохранить" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <Button Classes="sideMenuItem"
              Command="{Binding GoToDecksCommand}"
              ToolTip.Tip="К выбору колоды">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="📚" FontSize="18" VerticalAlignment="Center" />
          <TextBlock Text="Колоды" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <Button Classes="sideMenuItem"
              Command="{Binding ExitCommand}"
              ToolTip.Tip="Выйти из приложения">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="🚪" FontSize="18" VerticalAlignment="Center" />
          <TextBlock Text="Выход" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

    </StackPanel>
  </Border>

</UserControl>
