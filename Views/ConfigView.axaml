<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:menu="using:andecr.Views.Controls"
    xmlns:vm="using:andecr.ViewModels"
    x:Class="andecr.Views.ConfigView"
    x:Name="ConfigViewRoot"
    x:DataType="vm:ConfigViewModel">

    <Grid
        ColumnDefinitions="Auto,*">

        <menu:SideMenuView 
            Grid.Column="0" />

        <Grid
            Grid.Column="1"
            RowDefinitions="Auto,*,Auto">
            <!-- Header -->

            <Border
                Grid.Row="0"
                Padding="16,12">

                <Grid
                    ColumnDefinitions="*,*">

                    <TextBlock
                        Grid.Column="0"
                        Text="Configs"
                        FontSize="20"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Config Editor -->


        </Grid>

    </Grid>
</UserControl>