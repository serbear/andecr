<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:andecr.ViewModels"
    xmlns:controls="using:andecr.Controls"
    x:Class="andecr.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    Title="andecr"
    Width="1024"
    Height="768"
    WindowStartupLocation="CenterScreen"
    TransparencyLevelHint="None"
    Background="Transparent">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Panel>
        <!-- Set up a background for all controls. -->
        <controls:TiledBackgroundControl
            TileImage="{StaticResource TileBitmap}"
            TileWidth="Auto"
            TileHeight="Auto" />

        <Grid
            ColumnDefinitions="Auto,*,Auto">

            <!-- Left Menu -->
            <controls:LeftMenuView
                Grid.Column="0" />

            <!-- Screen Container -->
            <ContentControl
                Grid.Column="1"
                Content="{Binding CurrentScreen}" />
            
            <!-- Right Menu -->
            <controls:RightMenuView
                Grid.Column="2" />
        </Grid>
    </Panel>

</Window>