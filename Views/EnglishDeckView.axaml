<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:andecr.ViewModels"
             xmlns:menu="using:andecr.Views.Controls"
             xmlns:controls="using:andecr.Controls"
             x:Class="andecr.Views.EnglishDeckView"
             x:DataType="vm:EnglishDeckViewModel"
             x:Name="EnglishDeckEditorRoot">

    <Grid ColumnDefinitions="Auto,*">

        <!-- Общее боковое меню редактора колоды -->
        <menu:SideMenuView Grid.Column="0" />

        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

            <!-- Header -->
            <Border Grid.Row="0" Padding="16,12">
                <Grid ColumnDefinitions="*,*">
                    <TextBlock Grid.Column="0"
                               Text="Английский язык"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Card editor -->

            <TabControl Grid.Row="1"
                        Margin="16"
                        HorizontalAlignment="Stretch">

                <!-- Вкладка Term -->

                <TabItem Header="Термин">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8"
                                    Margin="16">

                            <controls:AndecrTextBox Label="Словарная статья"
                                                    Text="{Binding DictionaryEntry}"
                                                    Watermark="Название карточки в списке Anki" 
                                                    FieldWidth="600"/>

                            <controls:AndecrTextBox Label="Определение"
                                                    Text="{Binding Definition}"
                                                    Watermark="Описание слова из словаря"
                                                    AcceptsReturn="True"
                                                    TextWrapping="Wrap"
                                                    FieldHeight="70"
                                                    FieldWidth="600"/>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Вкладка Properties -->

                <TabItem Header="Свойства">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8"
                                    Margin="16">

                            <TextBlock Text="Тег"
                                       FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding Tags}"
                                      SelectedItem="{Binding Tag}"
                                      PlaceholderText="Смысловая область"
                                      HorizontalAlignment="Stretch" />

                            <TextBlock Text="Часть речи"
                                       Margin="0,8,0,0" />
                            <ComboBox ItemsSource="{Binding PartsOfSpeech}"
                                      SelectedItem="{Binding PartOfSpeech}"
                                      PlaceholderText="Выберите часть речи"
                                      HorizontalAlignment="Stretch" />

                            <TextBlock Text="Маркер"
                                       Margin="0,8,0,0" />
                            <ComboBox ItemsSource="{Binding Markers}"
                                      SelectedItem="{Binding Marker}"
                                      PlaceholderText="Стилистическая пометка"
                                      HorizontalAlignment="Stretch" />

                            <TextBlock Text="Уровень CEFR"
                                       Margin="0,8,0,0" />
                            <ComboBox ItemsSource="{Binding CefrLevels}"
                                      SelectedItem="{Binding CefrLevel}"
                                      PlaceholderText="A1 – C2"
                                      HorizontalAlignment="Stretch" />

                            <controls:AndecrTextBox Label="Транскрипция (брит.)"
                                                    Text="{Binding BritishTranscription}" 
                                                    FieldWidth="400"/>

                            <controls:AndecrTextBox Label="Транскрипция (амер.)"
                                                    Text="{Binding AmericanTranscription}" 
                                                    FieldWidth="400"/>

                            <controls:AndecrTextBox Label="Звук"
                                                    Text="{Binding Sound}"
                                                    Watermark="Ссылка на звуковой файл" 
                                                    FieldWidth="400"/>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Вкладка Context -->

                <TabItem Header="Контекст">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8"
                                    Margin="16">

                            <controls:AndecrTextBox Label="Оригинал"
                                                    Text="{Binding Original}"
                                                    Watermark="Контекст использования на английском"
                                                    AcceptsReturn="True"
                                                    TextWrapping="Wrap"
                                                    FieldHeight="60" 
                                                    FieldWidth="600" />

                            <controls:AndecrTextBox Label="Дословный перевод"
                                                    Text="{Binding LiteralTranslation}"
                                                    Watermark="Дословный перевод контекста"
                                                    AcceptsReturn="True"
                                                    TextWrapping="Wrap"
                                                    FieldHeight="60"
                                                    FieldWidth="600"/>

                            <controls:AndecrTextBox Label="Литературный перевод"
                                                    Text="{Binding LiteraryTranslation}"
                                                    Watermark="Смысловой перевод оригинала"
                                                    AcceptsReturn="True"
                                                    TextWrapping="Wrap"
                                                    FieldHeight="60" 
                                                    FieldWidth="600"/>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Вкладка Notes -->

                <TabItem Header="Заметки">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8"
                                    Margin="16">

                            <controls:AndecrTextBox Label="Заметки"
                                                    Text="{Binding Notes}"
                                                    Watermark="Произвольные примечания"
                                                    AcceptsReturn="True"
                                                    TextWrapping="Wrap"
                                                    FieldHeight="160" 
                                                    FieldWidth="600"/>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="16,12">
                <TextBlock Text="{Binding Cards.Count, StringFormat='Карточек в колоде: {0}'}"
                           Opacity="0.6"
                           HorizontalAlignment="Center" />
            </Border>

        </Grid>
    </Grid>

</UserControl>