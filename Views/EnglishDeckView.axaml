<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:andecr.ViewModels"
    xmlns:controls="using:andecr.Controls"
    xmlns:behaviors="clr-namespace:andecr.Behaviors"
    x:Class="andecr.Views.EnglishDeckView"
    x:DataType="vm:EnglishDeckViewModel"
    x:Name="EnglishDeckEditorRoot">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border
            Grid.Row="0"
            Padding="16,12">

            <Grid ColumnDefinitions="*,*">

                <TextBlock
                    Grid.Column="0"
                    Text="Английский язык"
                    FontSize="20"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>

        </Border>

        <!-- Card editor -->

        <TabControl
            Grid.Row="1"
            Margin="16"
            HorizontalAlignment="Stretch"
            SelectedIndex="{Binding SelectedTabIndex}">

            <!-- Вкладка Term -->

            <TabItem Header="Термин">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel
                        Spacing="8"
                        Margin="16">

                        <controls:AndecrTextBox
                            behaviors:FrozenBehavior.FieldName="DictionaryEntry"
                            Label="Словарная статья"
                            Text="{Binding [DictionaryEntry]}"
                            Watermark="Название карточки в списке Anki"
                            FieldWidth="400" />
                        <controls:AndecrTextBox
                            Label="Определение"
                            Text="{Binding [Definition]}"
                            Watermark="Описание слова из словаря"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            FieldHeight="70"
                            FieldWidth="400"
                            ShowFreezeButton="False"
                            TextTransform="{Binding NormalizeDefinitionPasteText}" />

                    </StackPanel>

                </ScrollViewer>

            </TabItem>

            <!-- Вкладка Properties -->

            <TabItem Header="Свойства">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel
                        Spacing="8"
                        Margin="16">

                        <TextBlock
                            Text="Тег"
                            FontWeight="SemiBold" />
                        <ComboBox
                            ItemsSource="{Binding Tags}"
                            SelectedItem="{Binding [Tag]}"
                            PlaceholderText="Смысловая область"
                            HorizontalAlignment="Stretch" />

                        <TextBlock
                            Text="Часть речи"
                            Margin="0,8,0,0" />
                        <controls:AndecrComboBox
                            behaviors:FrozenBehavior.FieldName="PartOfSpeech"
                            ItemsSource="{Binding PartsOfSpeech}"
                            SelectedItem="{Binding [PartOfSpeech]}"
                            Placeholder="Выберите часть речи"
                            ShowFreezeButton="True"
                            HorizontalAlignment="Stretch" />

                        <TextBlock
                            Text="Маркер"
                            Margin="0,8,0,0" />
                        <controls:MarkerList
                            x:Name="MarkerListControl"
                            HorizontalAlignment="Left"
                            MarkerItems="{Binding Markers}"
                            MarkersString="{Binding [Marker], Mode=OneWayToSource}" />

                        <TextBlock
                            Text="Уровень CEFR"
                            Margin="0,8,0,0" />
                        <ComboBox
                            ItemsSource="{Binding CefrLevels}"
                            SelectedItem="{Binding [CefrLevel]}"
                            PlaceholderText="A1 – C2"
                            HorizontalAlignment="Stretch" />

                        <!-- Transcription -->
                        
                        <StackPanel Orientation="Horizontal">

                            <StackPanel Orientation="Vertical">

                                <!-- <controls:AndecrTextBox -->
                                    <!-- behaviors:FrozenBehavior.FieldName="BritishTranscription" -->
                                    <!-- Label="Транскрипция (брит.)" -->
                                    <!-- Text="{Binding [BritishTranscription]}" -->
                                    <!-- FieldWidth="400" -->
                                    <!-- Name="UkTranscription"  -->
                                    <!-- /> -->
                                <controls:AndecrTextBox 
                                    behaviors:FrozenBehavior.FieldName="BritishTranscription"
                                    Label="Транскрипция (брит.)"
                                    Text="{Binding [BritishTranscription]}"
                                    FieldWidth="400"
                                    ShowToolbar="True" 
                                    Name="UkTranscription" >
                                    
                                    <controls:AndecrTextBox.SelectedTextTools>
                                        <controls:TextBoxTranscriptionSelectedTextTools />
                                    </controls:AndecrTextBox.SelectedTextTools>
                                    
                                </controls:AndecrTextBox> 
                                
                                <controls:AndecrTextBox
                                    behaviors:FrozenBehavior.FieldName="AmericanTranscription"
                                    Label="Транскрипция (амер.)"
                                    Text="{Binding [AmericanTranscription]}"
                                    FieldWidth="400"
                                    Name="UsTranscription" />
                                
                                
                            </StackPanel>

                            <controls:AndecrPasteBothButton
                                FirstTextBox="{Binding #UkTranscription}"
                                SecondTextBox="{Binding #UsTranscription}"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0" />

                        </StackPanel>

                        <controls:AndecrTextBox
                            behaviors:FrozenBehavior.FieldName="Sound"
                            Label="Звук"
                            Text="{Binding [Sound]}"
                            Watermark="Ссылка на звуковой файл"
                            FieldWidth="400" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Вкладка Context -->

            <TabItem Header="Контекст">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel
                        Spacing="8"
                        Margin="16">

                        <controls:AndecrTextBox
                            Label="Оригинал"
                            Text="{Binding [Original]}"
                            Watermark="Контекст использования на английском"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            FieldHeight="60"
                            FieldWidth="400"
                            ShowFreezeButton="False" />
                        <controls:AndecrTextBox
                            Label="Дословный перевод"
                            Text="{Binding [LiteralTranslation]}"
                            Watermark="Дословный перевод контекста"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            FieldHeight="60"
                            FieldWidth="400"
                            ShowFreezeButton="False" />
                        <controls:AndecrTextBox
                            Label="Литературный перевод"
                            Text="{Binding [LiteraryTranslation]}"
                            Watermark="Смысловой перевод оригинала"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            FieldHeight="60"
                            FieldWidth="400"
                            ShowFreezeButton="False" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Вкладка Notes -->

            <TabItem Header="Заметки">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel
                        Spacing="8"
                        Margin="16">

                        <controls:AndecrTextBox
                            Label="Заметки"
                            Text="{Binding [Notes]}"
                            Watermark="Произвольные примечания"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            FieldHeight="160"
                            FieldWidth="400"
                            ShowFreezeButton="False" />

                    </StackPanel>

                </ScrollViewer>

            </TabItem>

        </TabControl>

        <!-- Footer -->
        <Border
            Grid.Row="2"
            Padding="16,12">

            <TextBlock
                Text="{Binding Cards.Count, StringFormat='Карточек в колоде: {0}'}"
                Opacity="0.6"
                HorizontalAlignment="Center" />

        </Border>

    </Grid>

</UserControl>